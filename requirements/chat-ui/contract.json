                "properties": {
                    "message": {
                        "type": "string",
                        "title": "Message",
                        "description": "User message"
                    },
                    "conversation_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Conversation Id",
                        "description": "Existing conversation ID"
                    },
                    "user_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "User Id",
                        "description": "Existing user ID"
                    },
                    "user_name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "User Name",
                        "description": "User's name"
                    },
                    "email": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Email",
                        "description": "User's email"
                    },
                    "phone": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Phone",
                        "description": "User's phone number"
                    }
                },
                "type": "object",
                "required": [
                    "message"
                ],
                "title": "ChatRequest"
            },
            "ChatResponse": {
                "properties": {
                    "response": {
                        "type": "string",
                        "title": "Response",
                        "description": "Agent response"
                    },
                    "conversation_id": {
                        "type": "string",
                        "title": "Conversation Id",
                        "description": "Conversation ID"
                    },
                    "user_id": {
                        "type": "string",
                        "title": "User Id",
                        "description": "User ID"
                    },
                    "model_info": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Model Info",
                        "description": "Current model information"
                    }
                },
                "type": "object",
                "required": [
                    "response",
                    "conversation_id",
                    "user_id",
                    "model_info"
                ],
                "title": "ChatResponse"
            },
            "CodeVerificationRequest": {
                "properties": {
                    "user_id": {
                        "type": "string",
                        "title": "User Id",
                        "description": "User ID"
                    },
                    "code": {
                        "type": "string",
                        "title": "Code",
                        "description": "Verification code"
                    },
                    "contact_info": {
                        "type": "string",
                        "title": "Contact Info",
                        "description": "Email or phone number used"
                    }
                },
                "type": "object",
                "required": [
                    "user_id",
                    "code",
                    "contact_info"
                ],
                "title": "CodeVerificationRequest"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "ModelSwitchRequest": {
                "properties": {
                    "model_name": {
                        "type": "string",
                        "title": "Model Name",
                        "description": "Name of the model to switch to"
                    },
                    "conversation_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Conversation Id",
                        "description": "Conversation ID"
                    }
                },
                "type": "object",
                "required": [
                    "model_name"
                ],
                "title": "ModelSwitchRequest"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            },
            "VerificationRequest": {
                "properties": {
                    "contact_info": {
                        "type": "string",
                        "title": "Contact Info",
                        "description": "Email or phone number"
                    },
                    "contact_type": {
                        "type": "string",
                        "title": "Contact Type",
                        "description": "'email' or 'phone'"
                    },
                    "user_id": {
                        "type": "string",
                        "title": "User Id",
                        "description": "User ID"
                    },
                    "user_name": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "User Name",
                        "description": "User's name",
                        "default": "User"
                    }
                },
                "type": "object",
                "required": [
                    "contact_info",
                    "contact_type",
                    "user_id"
                ],
                "title": "VerificationRequest"
            },
            "VerificationResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "title": "Success"
                    },
                    "message": {
                        "type": "string",
                        "title": "Message"
                    },
                    "expires_in": {
                        "anyOf": [
                            {
                                "type": "integer"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Expires In"
                    },
                    "error": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Error"
                    }
                },
                "type": "object",
                "required": [
                    "success",
                    "message"
                ],
                "title": "VerificationResponse"
            }
        }
    }
